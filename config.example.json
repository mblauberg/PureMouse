{
  "dpi": 1600,
  "dpiPresets": [800, 1600, 3200],
  "scrollWheel": { "inverted": false, "mode": "ratchet", "smartShiftThreshold": 30 },
  "thumbWheel": { "action": "zoom", "reversed": false },
  "smoothScroll": { "speed": 1.0, "acceleration": 1.0, "smoothingMs": 125 },
  "buttons": {
    "back": "navigateBack",
    "forward": "default",
    "middle": "toggleScrollMode",
    "top": { "keys": "cmd+shift+4" },
    "gesture": { "click": "missionControl", "left": "spaceLeft", "right": "spaceRight", "up": "none" }
  },
  "gesture": { "distanceMm": 4, "repeatIntervalMs": 400 },
  "universalControl": { "handOff": true },
  "apps": {
    "com.apple.Safari": { "buttons": { "back": "previousTab", "forward": "nextTab" } },
    "com.valvesoftware.dota2": { "enabled": false }
  }
}
