# Release settings: sourced by verify-bundle.sh --release (and so by release.sh).
#
# The Team ID of the Developer ID Application certificate that signs releases (ten characters, shown
# in the identity's name and at developer.apple.com). Empty until the owner enrols: while it is
# empty, releases are checked for a release version and a valid signature only. Once set, every
# release must be signed by a Developer ID Application identity of this team.
PUREMOUSE_TEAM_ID=
