# The size budgets for PureMouse.app (installed) and the release dmg, checked by scripts/check-size.sh
# (release.sh runs it on both, so CI does).
# Raising one is a reviewed change: say in the pull request what grew and why.
#
# Measured 2026-11-02: the universal build (scripts/build-app.sh --universal, Swift 6.4.2,
# macOS 27.0.1, ad hoc signed) is 8245112 bytes. The budget is that plus 15%, rounded up to the
# next 0.1 MB (1 MB = 1,000,000 bytes).
INSTALLED_MAX_BYTES=9500000

# Measured 2026-11-02: the dmg that `scripts/release.sh --dry-run` makes (ULFO, same toolchain; the
# app inside measured 8189496 bytes installed) is 5659750 bytes. The README's download size is that
# figure. The budget is it plus 15%, rounded up to the next 0.1 MB.
DMG_MAX_BYTES=6600000
