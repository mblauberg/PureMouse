# The installed-size budget for PureMouse.app, checked by scripts/check-size.sh in CI.
# Raising it is a reviewed change: say in the pull request what grew and why.
#
# Measured 2026-11-02: the universal build (scripts/build-app.sh --universal, Swift 6.4.2,
# macOS 27.0.1, ad hoc signed) is 8245112 bytes. The budget is that plus 15%, rounded up to the
# next 0.1 MB (1 MB = 1,000,000 bytes).
INSTALLED_MAX_BYTES=9500000
